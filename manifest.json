{
  "manifest_version": 3,
  "name": "Download Manager Redirector",
  "version": "1.0.0",
  "description": "Redirects downloads to a local multithreaded download manager",
  "key": "",
  "permissions": [
    "downloads",
    "webRequest",
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
